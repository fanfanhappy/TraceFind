{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraceFind",
  "version": "2.10.0",
  "identifier": "com.tracefind.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TraceFind",
        "width": 800,
        "height": 540,
        "minWidth": 800,
        "minHeight": 540,
        "maxWidth": 800,
        "maxHeight": 540,
        "resizable": false,
        "center": false,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
